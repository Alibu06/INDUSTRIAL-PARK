{
  "name": "industrial-park",
  "version": "1.0.0",
  "private": true,
  "description": "Offline Gewerbepark-Wirtschaftssimulation",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.am.industrialpark",
    "productName": "Industrial Park",
    "copyright": "INDUSTRIAL PARK",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Industrial-Park-${version}-Windows.exe"
    }
  }
}